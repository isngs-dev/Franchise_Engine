# Copy to server/.env (git-ignored) and fill in. NEVER put these values in frontend code or commit them.

# From Google Cloud Console > APIs & Services > Credentials (enable the Google Calendar API and the Gmail API first)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Produced once by `npm run authorize`
GOOGLE_REFRESH_TOKEN=

# Which calendar receives the bookings ("primary" = the authorised account's own calendar)
GOOGLE_CALENDAR_ID=primary

# Confirmation emails are copied (cc) to this address
CONFIRMATION_CC=kaustubh.b1@isngs.com

# Booking rules. Times are in BOOKING_TZ (the team's time zone, an IANA name such as America/New_York or Europe/London).
# These are defaults, not business facts: set them to match your real availability.
BOOKING_TZ=
BOOKING_START_HOUR=9
BOOKING_END_HOUR=17
BOOKING_SLOT_MINUTES=30
BOOKING_DAYS=1,2,3,4,5
BOOKING_MIN_NOTICE_MINUTES=60
BOOKING_MAX_DAYS=60

# Server
PORT=8787
# If the website is hosted on a different origin than this API, set it here (and VITE_API_BASE in the frontend build)
ALLOWED_ORIGIN=
# Set to 1 when running behind a reverse proxy so rate limiting uses the real client IP
TRUST_PROXY=
